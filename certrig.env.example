# Copy to .env (git-ignored) next to this file and fill the blanks. `python -m leads` reads
# .env from the current directory automatically (or the file named by LEADS_ENV).

# --- Intake mailbox: the inbox that receives Breezy's "candidate applied" emails ---------
# Gmail works on a free account: turn on 2-Step Verification, then create an App Password
# (Google Account > Security > 2-Step Verification > App passwords) and paste it below.
# Zoho Mail's free plan has no IMAP (paid Mail Lite does); zoho values are imap.zoho.com /
# smtp.zoho.com if you go that way.
LEADS_IMAP_HOST=imap.gmail.com
LEADS_IMAP_USER=
LEADS_IMAP_PASSWORD=
LEADS_IMAP_FOLDER=INBOX
LEADS_OWN_DOMAINS=certrig.com,phtruckingpros.com

# --- Where new leads go ------------------------------------------------------------------
# Option A (recommended, no per-run charge that I know of): GoHighLevel API.
# Sub-account Settings > Private Integrations > create, scope "contacts.write"; copy the
# token. Location ID is in Settings > Business Profile (or the URL after /location/).
LEADS_GHL_TOKEN=
LEADS_GHL_LOCATION=
# Version header the GHL API wants; 2021-07-28 is my understanding, check the docs if 401/422
LEADS_GHL_VERSION=2021-07-28
# Option B: a GHL workflow "Inbound Webhook" trigger URL (Premium Action, charged per run).
LEADS_WEBHOOK=

# --- Only needed if the script itself sends the follow-up (`send`), not GHL ---------------
LEADS_SMTP_HOST=smtp.gmail.com
LEADS_SMTP_PORT=465
LEADS_SMTP_USER=
LEADS_SMTP_PASSWORD=
LEADS_FROM=support@certrig.com
LEADS_SENDER_NAME=Todd Bryson
LEADS_COMPANY=Certrig
LEADS_COURSE_URL=https://certrig.com/start
LEADS_POSTAL_ADDRESS=1056 Abilene Way, Park City, Utah 84098
LEADS_PHONE=
LEADS_DB=leads.db
