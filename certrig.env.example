# Copy to .env (git-ignored) next to this file and fill the blanks. `python -m leads` reads
# .env from the current directory automatically (or the file named by LEADS_ENV).
# Mail server values are my understanding of Zoho Mail's defaults; confirm them in
# Zoho Mail > Settings > Mail Accounts > IMAP/POP (IMAP access must be switched on there).
# If the account has two-factor auth, use an app-specific password, not the login password.
# Accounts on zoho.eu / zoho.in use those domains instead of zoho.com.
LEADS_IMAP_HOST=imap.zoho.com
LEADS_IMAP_USER=support@certrig.com
LEADS_IMAP_PASSWORD=
LEADS_IMAP_FOLDER=INBOX
LEADS_SMTP_HOST=smtp.zoho.com
LEADS_SMTP_PORT=465
LEADS_SMTP_USER=support@certrig.com
LEADS_SMTP_PASSWORD=
LEADS_FROM=support@certrig.com
LEADS_OWN_DOMAINS=certrig.com,phtruckingpros.com

LEADS_SENDER_NAME=Todd Bryson
LEADS_COMPANY=Certrig
LEADS_COURSE_URL=https://certrig.com/start
LEADS_POSTAL_ADDRESS=1056 Abilene Way, Park City, Utah 84098
LEADS_PHONE=
LEADS_DB=leads.db
# GoHighLevel: Automation > Workflows > new workflow > trigger "Inbound Webhook". Paste the
# URL it shows here; every new lead is POSTed to it (fields: first_name, last_name, email,
# phone, job_title, location, source, campaign, tags). Leave blank to use `send` instead.
LEADS_WEBHOOK=
